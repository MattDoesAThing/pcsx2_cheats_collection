gametitle=Silent Hill 2: Greatest Hits (NTSC-U) [SLUS-20228] [CRC FE06A030]
// Modernized/combined from the available FE06A030 PNACH sources for PCSX2 2.x toggleable groups.
// Legacy Maori-Jigglypuff writes are preserved exactly unless explicitly noted.
// Exact executable verified: SLUS_202.28 SHA-1 3A27DEDDFA81CF30F46F0742C3523230CAC75D9A

[60 FPS]
author=asasega
description=Current PCSX2 FE06A030 60 FPS patch. Original EE 001A6F50=14400009; replacement=10000009.
patch=1,EE,201A6F50,extended,10000009

[Cheats\Infinite Health]
author=Code Master
description=Direct health values. Preferred over the older legacy ASM health alternative below.
patch=1,EE,203FFEF4,extended,42C80000
patch=1,EE,203FFEFC,extended,42C80000

[Cheats\Invincible Can't Be Hit]
author=Code Master
description=Prevents James from being hit.
patch=1,EE,103FFF00,extended,000042C8

[Cheats\Infinite Run Never Exhausted]
author=floydfan
description=Run/stamina never exhausts.
patch=1,EE,21137C8C,extended,42C80000

[Cheats\Infinite Ammo]
author=Code Master
description=Ammunition is not consumed.
patch=1,EE,201B778C,extended,00000000

[Cheats\Have All Items]
author=Code Master
description=Sets the published Greatest Hits all-items flags.
patch=1,EE,21137C60,extended,FFFDF3FE
patch=1,EE,21137C64,extended,FFFFFFFF
patch=1,EE,21137C68,extended,00007FFF

[Cheats\Extra Ammo]
author=Code Master
description=Enables the Extra Ammo ranking/extra option flag.
patch=1,EE,021B7788,extended,00000001

[Cheats\No Saves Recorded]
author=Code Master
description=Keeps the recorded save count at zero.
patch=1,EE,012361EA,extended,00000000

[Yellow NEW GAME + Bullet Adjust + Noise Effect]
author=Savas Guercebe [Maori-Jigglypuff]
description=Makes NEW GAME yellow and unlocks Bullet Adjust and Noise Effect in Extra Options.
// "NEW GAME" appears in yellow Letters
// (PS2 thinks that you have beaten a Game)
// AND Unlock "Bullet Adjust" and "Noise Effect"
// in the Extra Options
patch=1,EE,012361E4,short,000001FF

[Cheats\Infinite Health (Legacy ASM Alternative)]
author=Savas Guercebe [Maori-Jigglypuff]
description=Legacy code from the uploaded FE06A030 file. Do not stack with the direct Infinite Health cheat.
// Infinite Health
patch=1,EE,001B05fC,word,C4410168
patch=1,EE,001B0604,word,E4410164

[No Noise Filter]
