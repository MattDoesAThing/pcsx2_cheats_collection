// in Japanese at first boot of the Game
// [Control Address and dynamic Value: 0x01101b84 000000XX]
patch=1,EE,001ec3e8,word,24420004

[Map on the Screen]
author=Savas Guercebe [Maori-Jigglypuff] / Snake356
description=Activates the auxiliary on-screen map. This line was commented/dormant in the legacy file; it is now safe as an explicit toggle.
// Activate auxiliary Map on the Screen!
patch=1,EE,01236269,byte,00000001

